# Panel de premiación Experiencia UEP (panelpolar.aulaciete.net). Solo LEE la base del juego.

# Clave del panel (usuario "uep"). Sin clave, el panel queda apagado. Muestra cédulas y nombres: compártela solo con UEP.
PANEL_PASSWORD=

# Base de datos del juego (la misma). Elige UNA:
# A) Postgres directo, idealmente con un usuario de solo lectura (ver README). Tiene prioridad.
DATABASE_URL=
# B) API de Supabase (la misma que usa el juego).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Niveles del juego (para saber quién completó todo).
TOTAL_NIVELES=4

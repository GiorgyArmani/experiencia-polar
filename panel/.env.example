# Panel de premiación Experiencia UEP (panelpolar.aulaciete.net). Solo LEE la base del juego.

# Clave del panel (es lo único que se pide para entrar). Sin clave, el panel queda apagado. Muestra cédulas y nombres: compártela solo con UEP.
PANEL_PASSWORD=

# Base de datos del juego (la misma). Elige UNA:
# A) Postgres directo, idealmente con un usuario de solo lectura (ver README). Tiene prioridad.
DATABASE_URL=
# B) API de Supabase (la misma que usa el juego).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Niveles del juego (para saber quién completó todo).
TOTAL_NIVELES=4

# Solo pruebas locales: muestra participantes inventados en vez de leer la base. Nunca en producción.
PANEL_DATOS_PRUEBA=false

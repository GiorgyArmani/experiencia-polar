# ─── Dominio ─────────────────────────────────────────────────────────
# URL pública del servidor. Es la que va dentro del QR (<APP_URL>/q/POLAR): si cambia, hay que reimprimirlo.
APP_URL=https://experiencia-polar.vercel.app

# ─── Base de datos (elige UNA) ─────────────────────────────────────────
# A) Postgres en Dokploy (o la cadena "Connection pooling" de Supabase). Tiene prioridad.
#    En Vercel + Supabase usa el pooler (puerto 6543).
DATABASE_URL=
# B) API de Supabase.
# Si no se define ninguna, la app usa memoria (solo pruebas: se borra al reiniciar).
SUPABASE_URL=
# Clave service_role: SOLO en el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Acceso ──────────────────────────────────────────────────────────
# false (por ahora) → cualquier cédula entra; si no está en la nómina, entra como "Jugador 1234" de la localidad "Pruebas".
# true → solo entran las cédulas de la tabla `nomina`. Activarlo cuando la UEP envíe la nómina.
NOMINA_OBLIGATORIA=false

# ─── Modo de juego ───────────────────────────────────────────────────
# demo     → cada trivia abre DEMO_WAIT_SECONDS después de terminar la anterior.
# schedule → cada trivia abre y cierra según TRIVIA_WINDOWS (hora del servidor).
GAME_MODE=demo
DEMO_WAIT_SECONDS=10

# Ventanas por trivia, en orden (ISO 8601 con zona horaria; Venezuela = -04:00).
# Ejemplo: Trivia 1 de 10:00 a 13:00, Trivia 2 de 13:00 a 16:00, etc.
TRIVIA_WINDOWS=[{"opensAt":"2026-10-29T10:00:00-04:00","closesAt":"2026-10-29T13:00:00-04:00"},{"opensAt":"2026-10-29T13:00:00-04:00","closesAt":"2026-10-29T16:00:00-04:00"},{"opensAt":"2026-10-30T10:00:00-04:00","closesAt":"2026-10-30T13:00:00-04:00"},{"opensAt":"2026-10-30T13:00:00-04:00","closesAt":"2026-10-30T16:00:00-04:00"}]

# Segundos entre el escaneo y el arranque del reloj del nivel: carga animada (~2 s) + mapa (0 a 15).
INTRO_SECONDS=8
# Contrarreloj: segundos para responder TODA la trivia.
TRIVIA_SECONDS=60
# Puntos máximos por respuesta correcta (si responde en ≤ 3 s); baja hasta la mitad a los 15 s. Incorrecta = 0.
POINTS_PER_CORRECT=100
# Última estación (la más difícil): puntos que resta cada respuesta incorrecta (0 = no resta).
# El total del jugador nunca baja de 0.
WRONG_PENALTY_LAST=50

# Localidades: por defecto las 130 de lib/localidades.ts (el jugador elige la suya; el ranking es por localidad).
# Opcional, para pruebas: SEDES=CODIGO:Nombre,CODIGO:Nombre reemplaza la lista.
# Ranking de una localidad en pantalla: <APP_URL>/ranking?sede=AG-LA-GUAIRA

# ─── App nativa ──────────────────────────────────────────────────────
# Enlaces de las tiendas (botones de la página /q/<CODIGO> cuando no tienen la app).
APP_STORE_URL=
PLAY_STORE_URL=
# Para que el QR abra la app directo si está instalada (universal links / app links).
APPLE_TEAM_ID=
ANDROID_SHA256_CERT=

# ─── Cliente ─────────────────────────────────────────────────────────
# Muestra el botón "Simular escaneo" y "Saltar espera" para pruebas.
NEXT_PUBLIC_DEMO=true

